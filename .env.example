# Copy to .env and adjust. docker-compose reads this file automatically.

# Password protecting the web UI and API (simple single-user auth)
APP_PASSWORD=changeme

# Secret used to sign session cookies — generate one: openssl rand -hex 32
SECRET_KEY=dev-secret-change-me

# LLM provider (agents, from Phase 1 onwards)
OPENROUTER_API_KEY=
# Default model for agents (OpenRouter slug)
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Research search for the curator agent (optional; falls back to DuckDuckGo)
TAVILY_API_KEY=

# TTS narration (OpenAI TTS: gpt-4o-mini-tts)
OPENAI_API_KEY=
TTS_VOICE=nova

# LangSmith tracing (optional; leave empty to disable)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-learning-factory
